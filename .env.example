# LinkedIn OAuth Credentials
# Get these from https://www.linkedin.com/developers/apps
LINKEDIN_CLIENT_ID=your_client_id_here
LINKEDIN_CLIENT_SECRET=your_client_secret_here

# OAuth callback URL (must match what's configured in LinkedIn Developer Portal)
LINKEDIN_REDIRECT_URI=http://localhost:3000/callback

# Optional: Token storage location (defaults to ~/.linkedin-ads-mcp/tokens.json)
# TOKEN_STORAGE_PATH=/custom/path/to/tokens.json

# OAuth options (space-separated scopes must be approved for your developer app)
# LINKEDIN_SCOPES=rw_ads r_ads_reporting r_organization_social w_organization_social
# LINKEDIN_OAUTH_TIMEOUT_MS=300000
# LINKEDIN_AUTH_NO_BROWSER=false

# API transport and safety settings
LINKEDIN_API_VERSION=202601
LINKEDIN_READ_ONLY=false
# LINKEDIN_REQUEST_TIMEOUT_MS=30000
# LINKEDIN_MAX_RETRIES=3
# LINKEDIN_RETRY_BASE_DELAY_MS=1000
# LINKEDIN_RETRY_MAX_DELAY_MS=30000
# LINKEDIN_MAX_CONCURRENCY=5
# LINKEDIN_PAGE_SIZE=100
# LINKEDIN_MAX_PAGES=1000
# LINKEDIN_MAX_UPLOAD_BYTES=20971520

# Dashboard settings (account ID is required only for dashboard generation)
# LINKEDIN_ADS_ACCOUNT_ID=123456789
# LINKEDIN_ADS_ACCOUNT_NAME=My advertising account
# DASHBOARD_START_DATE=2026-09-01
# DASHBOARD_END_DATE=2026-09-30
# DASHBOARD_OUTPUT_PATH=dashboard.html
# DASHBOARD_OPEN=false
