{
  "name": "linkedin-ads-mcp-toolkit",
  "version": "1.1.0",
  "description": "Configurable MCP server for LinkedIn advertising analytics and campaign management",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsc && node dist/index.js",
    "start": "node dist/index.js",
    "auth": "node dist/auth-cli.js",
    "dashboard": "npm run build && node dist/scripts/generate-dashboard.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:unit": "npm run build && node --test test/core.test.mjs test/auth.test.mjs",
    "test:integration": "npm run build && node --test test/mcp.test.mjs",
    "check": "npm run typecheck && npm test",
    "auth:logout": "npm run auth -- --logout",
    "performance": "npm run build && node dist/scripts/list_performance.js"
  },
  "keywords": [
    "mcp",
    "linkedin",
    "ads",
    "marketing",
    "analytics",
    "ai",
    "performance-marketing",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adops-tool/linkedin-ads-mcp-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/adops-tool/linkedin-ads-mcp-toolkit/issues"
  },
  "homepage": "https://github.com/adops-tool/linkedin-ads-mcp-toolkit#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^17.2.3",
    "open": "^10.1.0",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
